project:
  type: website
  output-dir: docs
  render:
      - index.qmd
      - about.qmd
      - 01_CT_gypsum_1D/01_C1_flow_tran.ipynb
      - 01_CT_gypsum_1D/02_C2_flow_tran.ipynb
      - 01_CT_gypsum_1D/03_U_flow_tran.ipynb
      - 01_CT_gypsum_1D/04_Uvis_flow_tran.ipynb
      - 01_CT_gypsum_1D/05_Uexch_flow_tran.ipynb
      - 01_CT_gypsum_1D/06_Uexch_vis_flow_tran.ipynb
      - 01_CT_gypsum_1D/07_Analysis_Vis.ipynb

website:
  title: "RTWMA"
  repo-url: https://github.com/luiggix/RTWMA
  navbar:
    background: primary
    left:
      - href: index.qmd
        text: Home
      - about.qmd
    right:
      - icon: github
        href: https://github.com/luiggix/RTWMA
  sidebar:
    style: "docked"
    search: true
    contents:
      - index.qmd
      - 01_CT_gypsum_1D/01_C1_flow_tran.ipynb
      - 01_CT_gypsum_1D/02_C2_flow_tran.ipynb
      - 01_CT_gypsum_1D/03_U_flow_tran.ipynb
      - 01_CT_gypsum_1D/04_Uvis_flow_tran.ipynb
      - 01_CT_gypsum_1D/05_Uexch_flow_tran.ipynb
      - 01_CT_gypsum_1D/06_Uexch_vis_flow_tran.ipynb
      - 01_CT_gypsum_1D/07_Analysis_Vis.ipynb

  page-navigation: true

format:
  html:
    theme:
      - cosmo
      - brand
    css: styles.css
    toc: true
    code-fold: true

date: today
date-format: iso

