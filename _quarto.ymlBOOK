project:
  type: book
  output-dir: docs
    
#crossref:
#  custom:
#    - key: exm
#      kind: float
#      reference-prefix: Ejem.
#      caption-prefix: Ejem. 
#      latex-env: Ejem.
#  sec-prefix: sección    # (default is "Section")
#  fig-prefix: figure     # (default is "Figure")
#  tbl-prefix: tableau    # (default is "Table")

lang: es

extensions:
  iconify:
    set: "octicon"
    size: "1.25em"
    width: "1em"
    height: "1em"
    flip: "horizontal"
    rotate: "0deg"
    inline: true
    mode: "svg"
    style: "color: #b22222;"
      
book:
  title: "RTWMA"
  subtitle: "Soluciones basadas en la naturaleza a la contaminación del agua subterránea por especies de nitrógeno."
  author:
    - name: "Luis Miguel De la Cruz Salas"
      affiliation: "Instituto de Geofísica, UNAM"
#  favicon: figuras/python1.png
  sidebar: 
##    background: "#F5F5F5"
#    logo: figuras/python1.png
    search: true
#  cover-image: figuras/python-logo-master-v3-TM.png
  sharing: [twitter, facebook, linkedin]
  reader-mode: true
  date: today
  chapters:
    - index.qmd
    - 01_CT_gypsum_1D/01_C1_flow_tran.ipynb

#    - part: part1.qmd
#     chapters:

#  appendices:
#    - notebooks/01_variables_objetos.ipynb
#    - glossary.qmd
#    - 5-appendices/A-instalacion.ipynb
#    - references.qmd

#bibliography: references.bib
#csl: apa.csl

format:
  html:
    toc: true
    number-sections: true
    theme: 
      light: [minty]
      dark: [cyborg]
    code-fold: false
    highlight-style: arrow
#    css: estilos/code-blocks.css
#  pdf:
#    documentclass: scrbook
#    number-sections: true
